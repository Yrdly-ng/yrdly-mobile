{
  "cli": {
    "version": ">= 14.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.15.0",
      "pnpm": "11.2.2",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "preview": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "distribution": "internal",
      "pnpm": "11.2.2"
    },
    "apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "node": "22.15.0",
      "pnpm": "11.2.2",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "channel": "production"
    },
    "verify-simulator": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "channel": "verify",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}