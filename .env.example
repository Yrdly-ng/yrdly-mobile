# Public app telemetry configuration. Use the ingestion host for your PostHog region.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# Leave false for local development. Preview/release builds enable configured SDKs.
EXPO_PUBLIC_TELEMETRY_DEBUG=false
EXPO_PUBLIC_TELEMETRY_DISABLED=false
EXPO_PUBLIC_APP_ENV=development

# Build-only: Sentry source-map uploads. Never prefix the token with EXPO_PUBLIC_.
SENTRY_ORG=yrdly-ltd
SENTRY_PROJECT=yrdly-mobile
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://sentry.io/
